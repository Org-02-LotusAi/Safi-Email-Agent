# SAFI Product 009 — environment variables (doc §5, §38: secrets never in code or yaml).
#
# Copy this file to `.env`, fill in real values, and never commit `.env` (it is already
# in .gitignore). `agents.yaml` references these variable names via `password_env:` —
# it never contains a raw password itself.

# --- LLM endpoint ------------------------------------------------------------
# Required for live mode (safi run). Leave unset to use only the offline FakeLlmClient.
ANTHROPIC_API_KEY=

# Force the LLM mode explicitly: "anthropic" or "fake".
# If unset: "anthropic" when ANTHROPIC_API_KEY is set, else "fake".
SAFI_LLM=

# --- Per-agent mailbox credentials (see agents.example.yaml password_env: refs) -------
REPLY_AGENT_IMAP_PASSWORD=
REPLY_AGENT_SMTP_PASSWORD=
SCHEDULE_AGENT_IMAP_PASSWORD=
SCHEDULE_AGENT_SMTP_PASSWORD=
